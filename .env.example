# Copy to .env.local and fill in real values. Never commit real keys.

# Server
PORT=3000

# Postgres connection string. Empty = snapshot mode (serves src/data/snapshot.json).
DATABASE_URL=

# Guard for /api/cron/refresh. Generate one: openssl rand -hex 32
CRON_SECRET=

# Public base URL, used by the OpenAPI server list and feed metadata.
NEXT_PUBLIC_SITE_URL=https://kiwi-djs.vercel.app
# GitHub repo "<owner>/<repo>" for feedback issue links.
GITHUB_REPO=olitreadwell/kiwi-djs
# Optional token, only needed to open issues from the feedback form.
GITHUB_TOKEN=

# Scraper keys. Each source is skipped when its key is missing.
EVENTFINDA_API_KEY=
DISCOGS_TOKEN=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_ACCESS_TOKEN=
DISCOGS_ACCESS_TOKEN_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
JINA_API_KEY=
DEEPSEEK_API_KEY=

# Per-run caps for the enrichment and summarize passes.
ENRICH_LIMIT=50
SUMMARIZE_LIMIT=50
MIXCLOUD_LIMIT=50
ARCHIVE_LIMIT=50
