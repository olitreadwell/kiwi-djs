{
  "name": "kiwi-djs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y",
    "perf": "pnpm dlx @lhci/cli@latest autorun",
    "smoke": "bash scripts/smoke.sh",
    "audit": "pnpm audit --audit-level=high",
    "security": "bash scripts/security-checks.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm security && pnpm build && pnpm smoke && pnpm test:e2e",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.mjs",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:snapshot": "node --env-file=.env.local --import tsx scripts/export-snapshot.mjs",
    "scrape": "node --env-file=.env.local --import tsx scripts/run-scrapers.ts",
    "summarize": "node --env-file=.env.local --import tsx scripts/summarize.ts",
    "loop": "node --env-file=.env.local --import tsx scripts/loop.ts",
    "contract": "node scripts/contract-test.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "type-fest": "5.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
