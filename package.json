{
  "name": "kiwi-djs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.mjs",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:snapshot": "node --env-file=.env.local --import tsx scripts/export-snapshot.mjs",
    "scrape": "node --env-file=.env.local --import tsx scripts/run-scrapers.ts",
    "summarize": "node --env-file=.env.local --import tsx scripts/summarize.ts",
    "loop": "node --env-file=.env.local --import tsx scripts/loop.ts",
    "typecheck": "tsc --noEmit",
    "contract": "node scripts/contract-test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "3.0.1",
    "type-fest": "5.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
