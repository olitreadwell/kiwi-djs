[codespell]
skip = .git,node_modules,.next,out,dist,coverage,playwright-report,test-results,.lighthouseci,*.html,pnpm-lock.yaml,snapshot.json,public
ignore-words-list = nd,wya,juni,numbe,expierence,wil,sting,pres,lew,oder,organise,organised,organisation,modelling,behaviour,licence,programme,defence,normalise,colour,abd,mane,tread,ot,rouge,te
check-hidden = false
quiet-level = 3
