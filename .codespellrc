[codespell]
skip = .git,node_modules,.next,out,dist,coverage,playwright-report,test-results,pnpm-lock.yaml,src/data/snapshot.json,public
ignore-words-list = organise,organised,organisation,modelling,behaviour,licence,programme,defence,normalise,colour,abd,mane,tread,ot,rouge,te
check-hidden = false
quiet-level = 3
